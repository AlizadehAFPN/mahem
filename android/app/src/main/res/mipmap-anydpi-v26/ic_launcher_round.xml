<?xml version="1.0" encoding="utf-8"?>
<!-- Same composition as ic_launcher.xml. The system masks an adaptive icon
     itself, so the round variant differs from the square one only in which
     resource a launcher asks for — see ic_launcher.xml for why this exists. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background" />
  <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
